{
  "name": "@tolinku/react-native-sdk",
  "version": "0.7.0",
  "description": "Tolinku React Native SDK for deep linking, analytics, referrals, and in-app messages",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "android/build.gradle",
    "android/src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tolinku/react-native-sdk"
  },
  "homepage": "https://tolinku.com/docs",
  "bugs": {
    "url": "https://github.com/tolinku/react-native-sdk/issues"
  },
  "keywords": [
    "tolinku",
    "deep-linking",
    "deferred-deep-links",
    "react-native",
    "analytics",
    "referrals",
    "universal-links",
    "app-links",
    "expo"
  ],
  "author": "Tolinku",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=1.19.0",
    "react": ">=18.0.0",
    "react-native": ">=0.72.0"
  },
  "peerDependenciesMeta": {
    "@react-native-async-storage/async-storage": {
      "optional": false
    }
  },
  "devDependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "jest": "^30.5.2",
    "react": "^19.3.1",
    "react-native": "^0.88.1",
    "ts-jest": "^29.4.15",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  },
  "jest": {
    "testEnvironment": "node",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "jsx": "react",
            "esModuleInterop": true,
            "types": [
              "jest",
              "node"
            ]
          }
        }
      ]
    },
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts"
    ]
  },
  "sideEffects": false,
  "overridesComment": "Dev-only, and not a preference. jest 30 pulls glob <=14.0.1 and minimatch <11.0.1, which carry a traversal-after-abort advisory and a globstar denial-of-service advisory. npm audit fix --force \"resolves\" both by downgrading jest to 25.1.0, so these pin the patched versions inside jest instead. Verified: full suite passes. The low-severity deepmerge advisory that remains has no patched release upstream (4.3.1 is both latest and vulnerable), so it stays until one exists. Drop these overrides once jest ships them itself.",
  "overrides": {
    "glob": "^14.0.6",
    "minimatch": "^11.0.8"
  }
}
